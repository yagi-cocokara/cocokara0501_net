# Claude API キー（AI による間延び検出に使用）
ANTHROPIC_API_KEY=sk-ant-...
# 使用モデル / 推論の深さ（low | medium | high | xhigh | max）
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# Whisper モデル（tiny / base / small / medium / large-v3）。GPU があれば large-v3 推奨
WHISPER_MODEL=small
# 設定すると「CapCut に直接追加」ボタンが使える（CapCut と同じ PC で動かす場合）
# Windows 例: C:\Users\you\AppData\Local\CapCut\User Data\Projects\com.lveditor.draft
CAPCUT_DRAFT_DIR=
